# Copy to .env; keep credentials out of version control. URL-encode the password.
# The database lives in the PostgreSQL instance this machine already shares; the compose
# stack starts no database container. Use the port that instance listens on.
# The host is the Docker bridge address of this machine (172.17.0.1 by default): the API
# container reaches the shared services through it, and host-run processes reach the same
# address. 127.0.0.1 only works for host-run processes.
DATABASE_URL=postgresql://eadp_user:REPLACE_WITH_ENCODED_PASSWORD@172.17.0.1:5432/eadp_studio
# An explicit decision is required. 'require' verifies the server certificate.
# For an authorized trusted-network test without TLS, explicitly choose 'disable'.
PG_SSL=require
GITLAB_URL=http://rddgit.changhong.com
GITLAB_ALLOW_HTTP=true
# Management credential stays in the collaboration API process. Never send it to the desktop.
SEI_GITLAB_TOKEN=
# The compose container publishes the API port to the host, so clients use this port.
HOST=0.0.0.0
PORT=6972
# Login session lifetime in days. The desktop caches the session token in the
# system secure store; this bounds how long that cached token stays valid.
STUDIO_SESSION_TTL_DAYS=90

# Optional local cache for GitLab reads (users, memberships, projects, namespace choices).
# The cache lives in the Redis instance this machine already shares; the compose stack
# starts no cache container. Redis unavailability degrades to uncached remote reads;
# it never blocks collaboration.
REDIS_URL=redis://172.17.0.1:6379

# Optional GitLab network proxy. Start Node with --use-env-proxy to enable it.
# NO_PROXY must contain the GITLAB_URL host, otherwise every GitLab call takes the proxy hop.
# HTTP_PROXY=http://proxy.example:7897
# HTTPS_PROXY=http://proxy.example:7897
# NO_PROXY=localhost,127.0.0.1,::1,GITLAB_HOST

# Independent publication role; repository membership does not grant it.
STUDIO_PUBLISHER_USER_IDS=
# Required only when enabling remote publication authorization.
PUBLIC_API_URL=
PUBLICATION_TOKEN_SECRET=

# Optional desktop mandatory-update policy. Unset MIN_VERSION to always clear clients.
# DESKTOP_UPDATE_MIN_VERSION=1.0.0
# DESKTOP_UPDATE_BLOCK_TITLE=请升级 eadp 工作台
# DESKTOP_UPDATE_BLOCK_DETAIL=当前版本已停止使用，请安装最新版本。
# DESKTOP_UPDATE_APP_LINK=https://download.example.com/eadp
