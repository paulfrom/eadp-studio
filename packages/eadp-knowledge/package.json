{
  "name": "@eadp/knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "知识库工作台插件",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@eadp/shell"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@eadp/contracts": "workspace:*"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "@types/react": "~18.3.1"
  }
}
