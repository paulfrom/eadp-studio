{
  "name": "@eadp/knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "\u77e5\u8bc6\u5e93\u5de5\u4f5c\u53f0\u63d2\u4ef6",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@eadp/shell"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/convert-worker.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "resources/builtin"
  ],
  "dependencies": {
    "@eadp/contracts": "workspace:*",
    "@eadp/shell": "workspace:*",
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pdfjs-dist": "6.3.289",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@lexical/code": "0.49.0",
    "@lexical/history": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/markdown": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@lexical/table": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@types/react": "~18.3.1",
    "lexical": "0.49.0",
    "react": "^18.2.0"
  }
}
