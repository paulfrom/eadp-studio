{
  "name": "eadp-prototype",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "umi dev --host 127.0.0.1",
    "typecheck": "umi setup && tsc --noEmit",
    "lint": "pnpm run lint:script && pnpm run lint:style",
    "lint:script": "eslint src config public/prototype-guard.js scripts/preview.mjs --ext .js,.mjs,.ts,.tsx --max-warnings 0",
    "lint:style": "stylelint \"src/**/*.less\"",
