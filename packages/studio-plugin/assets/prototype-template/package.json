    "@ant-design/cssinjs-utils": "^2.1.2",
    "@ant-design/fast-color": "^3.0.1",
    "@ead/antd-style": "^4.1.1",
    "@ead/suid": "^2.1.62",
    "@ead/suid-icons": "^1.2.11",
    "@ead/suid-utils-react": "^1.0.101",
    "@umijs/plugins": "^4.6.53",
    "ahooks": "^3.8.4",
    "clsx": "^2.1.1",
    "dayjs": "1.11.20",
    "lodash-es": "^4.17.21",
    "react": "^18",
    "react-activation": "^0.12.4",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@ead/babel-plugin-suid-import": "^2.0.22",
    "@types/node": "^24.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.11.0",
    "@umijs/lint": "4.3.31",
    "@umijs/preset-umi": "^4.6.56",
    "cross-env": "^6.0.0",
    "eslint": "8.x",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "stylelint": "14.x",
    "typescript": "^5.6.3",
    "umi": "^4.6.53",
    "umi-plugin-keep-alive": "0.0.1-beta.35"
  },
