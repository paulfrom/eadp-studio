    "preview": "node scripts/preview.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@ead/antd-style": "4.1.1",
    "@ead/suid": "2.1.62",
    "@ead/suid-icons": "1.2.11",
