    "@umijs/plugins": "4.6.53",
    "dayjs": "1.11.20",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@ead/babel-plugin-suid-import": "2.0.22",
    "@types/node": "22.19.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/parser": "8.11.0",
    "@umijs/lint": "4.3.31",
    "@umijs/preset-umi": "4.6.56",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-unused-imports": "4.0.1",
    "prettier": "3.3.2",
    "stylelint": "14.16.1",
    "typescript": "5.6.3",
    "umi": "4.6.53",
    "@typescript-eslint/eslint-plugin": "8.11.0"
  },
  "engines": {
    "node": "22.22.3",
    "pnpm": "11.28.5"
